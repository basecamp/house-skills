#!/usr/bin/env bash
# The one way address-pr-reviews reads a PR's feedback. Text written by anyone
# outside the company never reaches the agent: it comes back as a link for a
# person. gate.jq says who is inside. A refusal and any failure both exit 3, so
# a caller can't read past it.
#
# Usage: fetch-reviews OWNER/REPO NUMBER
# FETCH_REVIEWS_BOT_IDS adds review bots by database id, for a repo whose
# reviewers aren't the ones gate.jq lists. Set it yourself; never from a file
# in the repo under review, which the PR itself could change.
#
# A bot off that list is also inside when its GitHub App is owned by the repo's
# owner (gate.jq's owned_app), so an org's own apps need no list or setting.
# GraphQL's Bot carries no app or owner, and REST's performed_via_github_app
# is on issue comments but not reviews, so the owner comes from one
# GET /apps/<slug> per distinct off-list bot login per run (a bot's login is
# its app's slug), whatever it posted. Copilot, Codex and github-actions are on
# the list, so a usual PR needs one lookup or none. Only the app's slug and owner
# login are kept; its name and description never leave this script. A lookup
# that fails (a 404 for another org's private app, a rate limit, a network
# error), an owner missing from the answer, or an answer for a different slug
# leaves that bot out of the map, so it stays outside, as it was before.
set -euo pipefail
tmp=$(mktemp -d)
finish() {
  local status=$?
  rm -rf "$tmp"
  if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
    echo '{"refused": "the fetch failed, so nothing was read"}'
    exit 3
  fi
}
trap finish EXIT

command -v jq >/dev/null || { echo "fetch-reviews needs jq" >&2; exit 2; }
usage="usage: fetch-reviews OWNER/REPO NUMBER"
repo=${1:?$usage}
number=${2:?$usage}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
extra=$(jq -nc --arg ids "${FETCH_REVIEWS_BOT_IDS:-}" '[$ids | scan("[0-9]+") | tonumber]')

args=(-F owner="${repo%%/*}" -F name="${repo#*/}" -F number="$number")
vars='$owner: String!, $name: String!, $number: Int!'
pr='repository(owner: $owner, name: $name) { pullRequest(number: $number)'
who='authorAssociation author { __typename login ... on Bot { databaseId } }'
item="id url createdAt isMinimized minimizedReason body $who"

head() {
  gh api graphql "${args[@]}" -f query="query($vars) {
  viewer { login }
  repository(owner: \$owner, name: \$name) {
    owner { __typename login ... on Organization { viewerIsAMember } }
    pullRequest(number: \$number) { url headRefOid mergeable headRepositoryOwner { login }
      reviews { totalCount } comments { totalCount } reviewThreads { totalCount }
      labels(first: 100) { pageInfo { hasNextPage } nodes { name } }
      reviewRequests(first: 100) { pageInfo { hasNextPage } nodes { requestedReviewer {
        __typename ... on Bot { login databaseId } ... on User { login } ... on Team { slug } } } }
      $who } } }" > "$tmp/$1"
}
head head0.json

page() {
  gh api graphql --paginate --slurp "${args[@]}" -f query="query($vars, \$endCursor: String) {
    $pr { $1(first: 100, after: \$endCursor) {
      pageInfo { hasNextPage endCursor } nodes { $2 } } } } }" > "$tmp/$1.json"
}
page reviews "$item submittedAt state commit { oid }"
page comments "$item"
# GitHub prices a GraphQL query by the page sizes it asks for, not by what
# comes back: a request per connection, a point per hundred. This page (100
# threads x 100 comments) costs 1 point of the account's 5,000 an hour, shared by
# every session on it. Asking for reactions(first: 40) on each comment here made
# it 101. A thread longer than 100 comments comes back with hasNextPage, and
# gate.jq withholds it whole.
page reviewThreads "id isResolved isOutdated
  comments(first: 100) { pageInfo { hasNextPage } nodes { $item databaseId path line } }"

# Thumbs-ups, read only for the comments of unresolved threads, the only ones
# whose thumbs_up reaches the output, 100 to a query at 1 point each, and put
# back on their comments for gate.jq. A comment deleted since the page above
# can't be resolved, so gh fails and nothing is read.
jq -c '[.[].data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved | not)
  | .comments.nodes[]?.id] | unique | . as $all | range(0; length; 100) | $all[.:. + 100]' "$tmp/reviewThreads.json" > "$tmp/ids.jsonl"
: > "$tmp/reactions.jsonl"
while IFS= read -r ids; do
  jq -n --argjson ids "$ids" '{variables: {ids: $ids}, query: "query($ids: [ID!]!) { nodes(ids: $ids) {
    ... on PullRequestReviewComment { id reactions(content: THUMBS_UP, first: 40) { totalCount nodes { user { login } } } } } }"}' \
    > "$tmp/reactions-query.json"
  gh api graphql --input "$tmp/reactions-query.json" </dev/null >> "$tmp/reactions.jsonl"
done < "$tmp/ids.jsonl"
jq -s '[.[].data.nodes[] | select(. != null) | {(.id): .reactions}] | add // {}' "$tmp/reactions.jsonl" > "$tmp/reactions.json"
jq --slurpfile up "$tmp/reactions.json" \
  '(.[].data.repository.pullRequest.reviewThreads.nodes[].comments.nodes[]?) |= (. + ($up[0][.id // ""] | if . then {reactions: .} else {} end))' \
  "$tmp/reviewThreads.json" > "$tmp/threads-up.json"
mv "$tmp/threads-up.json" "$tmp/reviewThreads.json"

# Read the head again after the paged reads: if the head moved, or a review,
# comment or thread was added meanwhile, the feedback may not match what's
# judged, so refuse and let the caller run again. A reply added to an existing
# thread in that window isn't counted here; the next pass sees it.
head head.json
same() { jq -r '.data.repository.pullRequest | [.headRefOid, .reviews.totalCount, .comments.totalCount, .reviewThreads.totalCount] | @tsv' "$1"; }
[ "$(same "$tmp/head0.json")" = "$(same "$tmp/head.json")" ] || {
  echo '{"refused": "the PR changed while reading; run again"}'; exit 3; }

gate() {
  jq -n -f "$here/gate.jq" --argjson extra "$extra" --arg phase "$1" --slurpfile apps "$tmp/apps.json" \
    --slurpfile head "$tmp/head.json" \
    --slurpfile reviews "$tmp/reviews.json" \
    --slurpfile comments "$tmp/comments.json" \
    --slurpfile threads "$tmp/reviewThreads.json"
}
echo '{}' > "$tmp/apps.json"
gate bots | jq -r . > "$tmp/bots.txt"
: > "$tmp/apps.jsonl"
while IFS= read -r slug; do
  app=$(gh api "apps/$slug" --jq '{slug, owner: .owner.login}' </dev/null 2>/dev/null) &&
    jq -c --arg asked "$slug" '{asked: $asked} + .' <<<"$app" >> "$tmp/apps.jsonl" 2>/dev/null || true
done < "$tmp/bots.txt"
jq -s 'map(select((.slug | type) == "string" and (.slug | ascii_downcase) == .asked
    and (.owner | type) == "string") | {(.asked): .owner}) | add // {}' "$tmp/apps.jsonl" > "$tmp/apps.json"
gate judge > "$tmp/out.json"
cat "$tmp/out.json"
jq -e '.refused == null' "$tmp/out.json" >/dev/null || exit 3
