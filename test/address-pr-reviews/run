#!/usr/bin/env bash
# Runs address-pr-reviews' fetch-reviews against a stand-in gh that answers
# from fixtures. Every outside body carries MARKER-OUTSIDE; none may reach the
# output. Variants of head.json are made here, each named by what it changes.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
scripts=$here/../../plugins/dev/skills/address-pr-reviews/scripts
fetch=$scripts/fetch-reviews
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/bin"
cat > "$tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
# Answers only GraphQL; anything else is a fetch the skill shouldn't make. A
# fixture is the pages gh would fetch, in order. Like gh, the stub returns every
# page with --paginate, as one array with --slurp too, and only the first page
# without --paginate. Each field a fixture holds must be named somewhere in the
# query: the check is by name over the whole query, so a field asked for in one
# selection passes for another. A fixture with a field left out stands in for
# what gh returns when one selection drops it.
# The one REST call it answers is an app lookup, GET apps/<slug> with --jq, from
# $FX/apps.json keyed by slug: a slug not in it is a 404, as for an app that
# doesn't exist or another org's private one. Each lookup is logged to FX_CALLS.
[ -z "${FX_FAIL:-}" ] || { echo "stub gh: simulated failure" >&2; exit 1; }
if [ "${1:-}" = api ] && [[ ${2:-} == apps/* ]]; then
  slug=${2#apps/} filter=. prev=''
  echo "$slug" >> "$FX_CALLS"
  for arg in "$@"; do [ "$prev" != --jq ] || filter=$arg; prev=$arg; done
  [ -z "${FX_APPS_FAIL:-}" ] || { echo "stub gh: simulated failure" >&2; exit 1; }
  jq -e --arg s "$slug" 'has($s)' "$FX/apps.json" >/dev/null 2>&1 \
    || { echo '{"message":"Not Found","status":"404"}'; echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
  jq --arg s "$slug" '.[$s]' "$FX/apps.json" | jq -c "$filter"
  exit
fi
[ "${1:-} ${2:-}" = "api graphql" ] || { echo "stub gh: not a GraphQL call: $*" >&2; exit 1; }
paginate='' slurp='' query=''
for arg in "$@"; do
  case "$arg" in
    --paginate) paginate=1 ;;
    --slurp) slurp=1 ;;
    query=*) query=${arg#query=} ;;
    id=*) id=${arg#id=} ;;
  esac
done
case "$query" in
  # resolve-thread's mutation: recorded, so a test can tell whether it ran.
  *"resolveReviewThread("*) echo "$query" >> "$FX_STATE.resolved"
    echo '{"data": {"resolveReviewThread": {"thread": {"id": "t", "isResolved": true}}}}'; exit 0 ;;
  *"statusCheckRollup"*) file=$FX_CHECKS ;;
  # resolve-thread's recount: the thread's comments in the fixture, plus
  # FX_REPLIES more, standing in for replies posted while it ran.
  *"node(id:"*) jq -c --arg id "$id" --argjson more "${FX_REPLIES:-0}" '[.[].data.repository.pullRequest.reviewThreads.nodes[]
      | select(.id == $id)][0] | {data: {node: {isResolved, comments: {totalCount: ((.comments.nodes | length) + $more)}}}}' \
      "$FX/threads.json"; exit 0 ;;
  *"reviewThreads("*) file=$FX/threads.json ;;
  *"reviews("*) file=$FX/reviews.json ;;
  *"comments(first"*) file=$FX/comments.json ;;
  *) file=$FX_HEAD
     # FX_HEAD_LATER stands in for a push between the first and second head read.
     if [ -n "${FX_HEAD_LATER:-}" ]; then
       if [ -e "$FX_STATE" ]; then file=$FX_HEAD_LATER; else : > "$FX_STATE"; fi
     fi ;;
esac
for key in $(jq -r '[.. | objects | keys[]] | unique[] | select(. != "data")' "$file"); do
  grep -qw -- "$key" <<<"$query" || { echo "stub gh: the query doesn't ask for $key" >&2; exit 1; }
done
if [ "$file" = "$FX_HEAD" ] || [ "$file" = "${FX_HEAD_LATER:-}" ] || [ "$file" = "${FX_CHECKS:-}" ]; then cat "$file"
elif [ -z "$paginate" ]; then jq '.[0]' "$file"
elif [[ $query != *'after: $endCursor'* ]]; then echo "stub gh: --paginate without \$endCursor" >&2; exit 1
elif [ -n "$slurp" ]; then cat "$file"
else jq -c '.[]' "$file"
fi
EOF
chmod +x "$tmp/bin/gh"

fail=0
check() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1: got $2, want $3"; fail=1; fi; }
# run HEAD_FILTER: prints the output, then the exit status on the last line.
run() {
  jq "$1" "$here/fixtures/head.json" > "$tmp/head.json"
  rm -f "$tmp/head-read"
  : > "$tmp/calls"
  local status=0
  PATH="$tmp/bin:$PATH" FX="${FXDIR:-$here/fixtures}" FX_HEAD="$tmp/head.json" FX_STATE="$tmp/head-read" FX_CALLS="$tmp/calls" \
    "$fetch" o/r 1 > "$tmp/out.json" 2>/dev/null || status=$?
  cat "$tmp/out.json"; echo "$status"
}
out() { sed '$d' <<<"$1"; }
status() { tail -n 1 <<<"$1"; }
pr=.data.repository.pullRequest

got=$(run .)
check "a member's PR is read" "$(status "$got")" 0
check "no outside text reaches the output" "$(grep -c MARKER-OUTSIDE <<<"$got" || true)" 0
check "inside items kept" "$(out "$got" | jq -c '[.reviews[].id, .comments[].id, .threads[].id]')" \
  '["r1","r3","r7","c4","c6","c7","c10","c18","c14","c16","t2","t4","t11"]'
check "an outside comment a person hid as Resolved comes through as a link, marked cleared, without its text" \
  "$(out "$got" | jq -c '[.threads[] | select(.id == "t4") | .comments[] | [.id, (.cleared // false), has("body")]]')" '[["t4a",false,true],["t4b",true,false]]'
check "a member's text comes through as written, quotes included" \
  "$(out "$got" | jq -c '.comments[] | select(.id == "c6") | .body')" '"> a member quoting the PR\n\nthanks, will fix"'
check "Unicode tag characters are stripped; emoji with joiners and U+FE0F, and a U+E0100 variant, come through intact" \
  "$(out "$got" | jq -a -c '.comments[] | select(.id == "c16") | .body')" \
  '"pasted error: \ud83c\udff3\ufe0f\u200d\ud83c\udf08 \ud83d\udc69\u200d\ud83d\udcbb \u2764\ufe0f \u845b\udb40\udd00"'
check "Codex's summary comment comes through whole, so its Completed row on the head can be read" \
  "$(out "$got" | jq -c '.comments[] | select(.id == "c7") | .body')" \
  "$(jq -c '.[0].data.repository.pullRequest.comments.nodes[] | select(.id == "c7") | .body' "$here/fixtures/comments.json")"
check "the last summary comment from the token's account comes through whole, so a pass can tell whether its own is new" \
  "$(out "$got" | jq -c '.comments[] | select(.id == "c10") | .body')" \
  "$(jq -c '.[].data.repository.pullRequest.comments.nodes[] | select(.id == "c10") | .body' "$here/fixtures/comments.json")"
check "every kept item has a url" \
  "$(out "$got" | jq '[.reviews[], .comments[], .threads[].comments[]] | all(.url != null)')" true
check "convergence's fields come through: head, mergeable, review commits, thread comment ids" \
  "$(out "$got" | jq -c '[.head, .mergeable, (.reviews[] | .commit), (.threads[0].comments[0] | .databaseId)]')" \
  '["abc","MERGEABLE","abc","abc","abc",1]'
check "outside items listed by link, resolved threads included" \
  "$(out "$got" | jq -c '[.withheld[] | "\(.kind):\(.url | ltrimstr("https://x/"))"]')" \
  '["thread:t1b","thread:t3a","thread:t7a","thread:t8b","thread:t10a","thread:t12a","thread:t13a","thread-comment:t5b","thread-comment:t9b","review:r2","review:r5","review:r6","review:r8","comment:c1","comment:c2","comment:c3","comment:c8","comment:c13","comment:c17","comment:c19","comment:c15"]'
check "later pages are read: inside items kept, outside items withheld" \
  "$(out "$got" | jq -c '[.reviews[].id, .comments[].id, .threads[].id | select(IN("r7", "c14", "t11"))],
    [.withheld[].url | ltrimstr("https://x/") | select(IN("r8", "c15", "t12a"))]')" \
  "$(printf '%s\n%s' '["r7","c14","t11"]' '["t12a","r8","c15"]')"
check "a withheld thread or review holds convergence; a withheld plain comment, or a comment in a resolved thread, doesn't" \
  "$(out "$got" | jq -c '[.withheld[] | select(IN(.url; "https://x/t7a", "https://x/t5b", "https://x/r5", "https://x/c3")) | [.kind, .holds]]')" \
  '[["thread",true],["thread-comment",false],["review",true],["comment",false]]'
check "each kept item says whether a person or a bot wrote it" \
  "$(out "$got" | jq -c '[.comments[] | select(IN(.id; "c6", "c7")) | .by]')" '["person","bot"]'
check "a PR comment from a bot off the list is withheld, not dropped" \
  "$(out "$got" | jq -c '[.withheld[] | select(.url == "https://x/c3") | [.kind, .by]]')" '[["comment","bot"]]'
check "a resolved thread too long to fetch whole is withheld whole, like an unresolved one" \
  "$(out "$got" | jq -c '[.withheld[] | select(.url == "https://x/t10a") | .kind]')" '["thread"]'
check "an outside item hidden for any reason but Resolved stays withheld, and holds its thread" \
  "$(out "$got" | jq -c '[.withheld[].url | ltrimstr("https://x/") | select(IN("t8b", "t9b", "r6", "c13"))], [.threads[].id | select(. == "t8")]')" \
  "$(printf '%s\n%s' '["t8b","t9b","r6","c13"]' '[]')"

check "a thread whose comments came back with no pageInfo is withheld whole, not read" \
  "$(out "$got" | jq -c '[.threads[].id | select(. == "t13")], [.withheld[] | select(.url == "https://x/t13a") | .kind]')" \
  "$(printf '%s\n%s' '[]' '["thread"]')"

refuses() {
  got=$(run "$2")
  check "$1" "$(status "$got") $(out "$got" | jq -r '.refused != null')" "3 true"
}
refuses "a token that can't see members refuses" '.data.repository.owner.viewerIsAMember = false'
refuses "a contributor's PR refuses" "$pr.authorAssociation = \"CONTRIBUTOR\""
refuses "an off-list bot's PR refuses" "$pr.author = {__typename: \"Bot\", login: \"some-app\", databaseId: 900010}"
refuses "a bot named dependabot with another id refuses" "$pr.author = {__typename: \"Bot\", login: \"dependabot\", databaseId: 900011}"
got=$(FETCH_REVIEWS_BOT_IDS="900010" run "$pr.author = {__typename: \"Bot\", login: \"some-app\", databaseId: 900010}")
check "FETCH_REVIEWS_BOT_IDS doesn't make a bot's PR readable" "$(status "$got")" 3
refuses "a review bot's PR refuses" "$pr.author = {__typename: \"Bot\", login: \"chatgpt-codex-connector\", databaseId: 199175422}"
refuses "a User named dependabot[bot] who isn't a member refuses" "$pr.author = {__typename: \"User\", login: \"dependabot[bot]\"} | $pr.authorAssociation = \"NONE\""
check "a Dependabot PR is read" "$(status "$(run "$pr.author = {__typename: \"Bot\", login: \"dependabot\", databaseId: 49699333} | $pr.authorAssociation = \"NONE\"")")" 0
check "a github-actions PR is read" "$(status "$(run "$pr.author = {__typename: \"Bot\", login: \"github-actions\", databaseId: 41898282} | $pr.authorAssociation = \"NONE\"")")" 0
refuses "a head in someone else's fork refuses" "$pr.headRepositoryOwner = {login: \"someone\"}"
refuses "a head whose fork is gone refuses" "$pr.headRepositoryOwner = null"
refuses "a PR labeled outside-text refuses" "$pr.labels.nodes += [{name: \"outside-text\"}]"
refuses "the label matches whatever its case" "$pr.labels.nodes += [{name: \"Outside-Text\"}]"
got=$(FX_FAIL=1 run .)
check "a failed fetch exits 3 and reads nothing" "$(status "$got") $(out "$got" | jq -c .)" \
  '3 {"refused":"the fetch failed, so nothing was read"}'

check "a head in the author's own fork is read" "$(status "$(run "$pr.headRepositoryOwner = {login: \"member\"}")")" 0
check "a personal repo is read when it's the token's own" "$(status "$(run ".data.repository.owner = {__typename: \"User\", login: \"me\"}
  | $pr.author.login = \"me\" | $pr.authorAssociation = \"OWNER\" | $pr.headRepositoryOwner = {login: \"me\"}")")" 0
# Outside the company's orgs, the org's own members are outsiders: only the
# token's account and the review bots come through, and membership isn't needed.
elsewhere='.data.repository.owner = {__typename: "Organization", login: "other-org", viewerIsAMember: false}
  | '"$pr"'.headRepositoryOwner = {login: "other-org"}'
refuses "outside the company's orgs, a member's PR refuses" "$elsewhere"
got=$(run "$elsewhere | $pr.author.login = \"me\"")
check "outside the company's orgs, only the token's account and review bots come through" \
  "$(status "$got") $(out "$got" | jq -c '[.reviews[].id, .comments[].id, .threads[].id]')" \
  '0 ["r1","r3","r7","c7","c10","t2","t4","t11"]'
check "outside the company's orgs, a member's text is withheld" \
  "$(out "$got" | jq -c '[.withheld[].url | ltrimstr("https://x/") | select(IN("c4", "c6", "t6a"))]')" \
  '["t6a","c4","c6"]'
got=$(FETCH_REVIEWS_BOT_IDS="99" run .)
check "FETCH_REVIEWS_BOT_IDS adds a review bot" \
  "$(out "$got" | jq -c '[(.reviews[], .threads[]) | select(.id == "r5" or .id == "t7") | .id], [.withheld[].url | select(test("r5|t7"))]')" \
  "$(printf '%s\n%s' '["r5","t7"]' '[]')"
# A push between the first head read and the last: the feedback may not match
# the head being judged, so it refuses.
jq "$pr.headRefOid = \"def\"" "$here/fixtures/head.json" > "$tmp/head-later.json"
got=$(FX_HEAD_LATER="$tmp/head-later.json" run .)
check "a head that moves while reading refuses" "$(status "$got") $(out "$got" | jq -c .)" \
  '3 {"refused":"the PR changed while reading; run again"}'
jq "$pr.reviews.totalCount += 1" "$here/fixtures/head.json" > "$tmp/head-updated.json"
got=$(FX_HEAD_LATER="$tmp/head-updated.json" run .)
check "a review added while reading (same head) refuses" "$(status "$got") $(out "$got" | jq -c .)" \
  '3 {"refused":"the PR changed while reading; run again"}'

# A trusted review with no body still says which head its reviewer read.
mkdir "$tmp/fx-empty"; cp "$here"/fixtures/*.json "$tmp/fx-empty/"
jq '(.[0].data.repository.pullRequest.reviews.nodes[] | select(.id == "r1") | .body) = ""' \
  "$here/fixtures/reviews.json" > "$tmp/fx-empty/reviews.json"
got=$(FXDIR="$tmp/fx-empty" run .)
check "a trusted review with an empty body is kept, with its commit" \
  "$(out "$got" | jq -c '[.reviews[] | select(.id == "r1") | [.body, .commit]]')" '[["","abc"]]'

check "an outside collaborator's comment hidden as Resolved stays withheld (they can hide their own)" \
  "$(out "$(run .)" | jq -c '[.withheld[] | select(.url == "https://x/c17") | .kind]')" '["comment"]'
check "reviewers asked for but not yet reported come through, so a pending Copilot pass is seen" \
  "$(out "$(run .)" | jq -c '[.requested, .requested_complete]')" '[["copilot-pull-request-reviewer"],true]'
refuses "a PR whose labels run past one page refuses" "$pr.labels.pageInfo.hasNextPage = true"

# Outside the company's orgs, an org member hiding their own comment as Resolved
# doesn't clear it; nor does an off-list bot.
got=$(run "$elsewhere | $pr.author.login = \"me\"")
check "outside the company's orgs, a member's own Resolved hide doesn't clear it" \
  "$(out "$got" | jq -c '[.withheld[] | select(.url == "https://x/c18") | .kind]')" '["comment"]'
check "an off-list bot's own Resolved hide doesn't clear it" \
  "$(out "$(run .)" | jq -c '[.withheld[] | select(.url == "https://x/c19") | .kind]')" '["comment"]'

# A bot whose GitHub App the repo's owner owns is inside, wherever it posts; a
# bot of another owner's app, an app whose lookup fails or comes back without
# an owner or for another slug, and a User named like an app's bot stay
# withheld. These fixtures are made up: the apps and their ids belong to no one.
mkdir "$tmp/fx-apps"; cp "$here"/fixtures/*.json "$tmp/fx-apps/"
node() { jq -nc --arg id "$1" --arg type "$2" --arg login "$3" --argjson db "$4" --arg assoc "$5" \
  '{id: $id, url: "https://x/\($id)", createdAt: "2026-01-03", isMinimized: false,
    body: "\(if $assoc == "outside" then "MARKER-OUTSIDE " else "" end)\($login) as \($type)",
    authorAssociation: "NONE", author: ({__typename: $type, login: $login}
      + if $type == "Bot" then {databaseId: $db} else {} end)}'; }
comment() { node "$@" inside; }
outside() { node "$@" outside; }
jq --argjson add "[$(comment a1 Bot house-app 900001),
    $(outside a3 Bot elsewhere-app 900002), $(outside a4 User 'house-app[bot]' 0),
    $(comment a5 Bot github-actions 41898282), $(outside a6 User 'github-actions[bot]' 0),
    $(outside a7 Bot ownerless-app 900003), $(outside a8 Bot renamed-app 900004),
    $(outside a9 Bot 'bad/slug' 900005), $(outside a10 Bot my-app 900006),
    $(outside a11 Bot $'house-app\n' 900007)]" \
  '.[0].data.repository.pullRequest.comments.nodes += $add' \
  "$here/fixtures/comments.json" > "$tmp/fx-apps/comments.json"
jq --argjson add "$(comment a2 Bot house-app 900001)" \
  '.[0].data.repository.pullRequest.reviews.nodes += [$add + {state: "COMMENTED", commit: {oid: "abc"}}]' \
  "$here/fixtures/reviews.json" > "$tmp/fx-apps/reviews.json"
jq --argjson add "$(comment ta1 Bot house-app 900001)" \
  '.[0].data.repository.pullRequest.reviewThreads.nodes += [{id: "ta", isResolved: false, isOutdated: false,
    comments: {pageInfo: {hasNextPage: false}, nodes: [$add + {databaseId: 90, path: "p", line: 1}]}}]' \
  "$here/fixtures/threads.json" > "$tmp/fx-apps/threads.json"
cat > "$tmp/fx-apps/apps.json" <<'EOF'
{
  "house-app": {"slug": "house-app", "name": "MARKER-OUTSIDE name", "description": "MARKER-OUTSIDE description", "owner": {"login": "BaseCamp", "type": "Organization"}},
  "elsewhere-app": {"slug": "elsewhere-app", "owner": {"login": "other-org", "type": "Organization"}},
  "github-actions": {"slug": "github-actions", "owner": {"login": "github", "type": "Organization"}},
  "ownerless-app": {"slug": "ownerless-app"},
  "renamed-app": {"slug": "another-app", "owner": {"login": "basecamp", "type": "Organization"}},
  "my-app": {"slug": "my-app", "owner": {"login": "me", "type": "User"}},
  "author-app": {"slug": "author-app", "owner": {"login": "basecamp", "type": "Organization"}}
}
EOF
apps() { FXDIR="$tmp/fx-apps" run "$@"; }
kept='[.reviews[].id, .comments[].id, .threads[].id] | map(select(test("^(a|ta)")))'
withheld='[.withheld[].url | ltrimstr("https://x/") | select(test("^(a|ta)"))]'
got=$(apps .)
check "an app the repo's org owns is inside in a review, a comment and a thread, its owner matched whatever its case" \
  "$(status "$got") $(out "$got" | jq -c "$kept")" '0 ["a2","a1","a5","ta"]'
check "another org's app, a failed or ownerless lookup, an answer for another slug, a login that isn't a slug, and a User named like a bot are withheld" \
  "$(out "$got" | jq -c "$withheld")" '["a3","a4","a6","a7","a8","a9","a10","a11"]'
check "no outside text, nor an app's name or description, reaches the output" \
  "$(grep -c MARKER-OUTSIDE <<<"$got" || true)" 0
check "github-actions[bot] is inside by type and id; a User named github-actions[bot] is withheld" \
  "$(out "$got" | jq -c '[.comments[].id | select(. == "a5")], [.withheld[].url | select(. == "https://x/a6")]')" \
  "$(printf '%s\n%s' '["a5"]' '["https://x/a6"]')"
check "each off-list bot is looked up once, a listed bot or a User never, and a login that isn't a slug never" \
  "$(sort "$tmp/calls" | jq -Rsc 'split("\n")[:-1]')" \
  '["ci-app","elsewhere-app","house-app","my-app","ownerless-app","renamed-app","some-app","somebot"]'
check "a PR by an app the repo's org owns is read, looked up as its author; another org's app's PR refuses" \
  "$(status "$(apps "$pr.author = {__typename: \"Bot\", login: \"author-app\", databaseId: 900020} | $pr.authorAssociation = \"NONE\"")") $(status "$(apps "$pr.author = {__typename: \"Bot\", login: \"elsewhere-app\", databaseId: 900002} | $pr.authorAssociation = \"NONE\"")")" \
  '0 3'
got=$(apps "$elsewhere | $pr.author = {__typename: \"Bot\", login: \"elsewhere-app\", databaseId: 900002} | $pr.authorAssociation = \"NONE\" | $pr.headRepositoryOwner = {login: \"other-org\"}")
check "on another org's repo, even that org's own app's PR refuses" "$(status "$got")" 3
refuses "on another org's repo, a Dependabot PR refuses" "$elsewhere | $pr.author = {__typename: \"Bot\", login: \"dependabot\", databaseId: 49699333}"
check "a PR by an owned app is read even with its id in FETCH_REVIEWS_BOT_IDS" \
  "$(status "$(FETCH_REVIEWS_BOT_IDS=900020 apps "$pr.author = {__typename: \"Bot\", login: \"author-app\", databaseId: 900020} | $pr.authorAssociation = \"NONE\"")")" 0
got=$(FX_APPS_FAIL=1 apps .)
check "a failed app lookup is tried once, leaves the app's bot withheld, and the rest is still read" \
  "$(status "$got") $(grep -cx house-app "$tmp/calls") $(out "$got" | jq -c "$kept") $(out "$got" | jq -c "[.withheld[].url | select(test(\"/(a1|a2|ta1)\$\"))]")" \
  '0 1 ["a5"] ["https://x/ta1","https://x/a2","https://x/a1"]'
got=$(apps "$elsewhere | $pr.author.login = \"me\"")
check "on another org's repo, that org's app is inside and the company's is withheld" \
  "$(out "$got" | jq -c "$kept"), $(out "$got" | jq -c "$withheld" | jq -c 'map(select(IN("a1", "a3")))')" \
  '["a3","a5"], ["a1"]'
got=$(apps ".data.repository.owner = {__typename: \"User\", login: \"me\"}
  | $pr.author.login = \"me\" | $pr.authorAssociation = \"OWNER\" | $pr.headRepositoryOwner = {login: \"me\"}")
check "on a personal repo, its owner's own app is inside" \
  "$(out "$got" | jq -c "$kept" | jq -c 'map(select(IN("a1", "a10")))')" '["a10"]'

# A person accepts an answer by a reply, an approval, or a thumbs-up on it. The
# thumbs-up comes through only from the token's account and the people who
# wrote in the thread: a stranger's login never reaches the output.
mkdir "$tmp/fx-agree"; cp "$here"/fixtures/*.json "$tmp/fx-agree/"
jq '.[0].data.repository.pullRequest.reviewThreads.nodes += [{id: "tp", isResolved: false, isOutdated: false,
    comments: {pageInfo: {hasNextPage: false}, nodes: [
      {id: "tp1", url: "https://x/tp1", createdAt: "2026-01-04", isMinimized: false, body: "rename this",
       authorAssociation: "MEMBER", author: {__typename: "User", login: "member"}, databaseId: 91, path: "p", line: 1,
       reactions: {nodes: []}},
      {id: "tp2", url: "https://x/tp2", createdAt: "2026-01-05", isMinimized: false, body: "Not doing this — reasons",
       authorAssociation: "MEMBER", author: {__typename: "User", login: "me"}, databaseId: 92, path: "p", line: 1,
       reactions: {totalCount: 3, nodes: [{user: {login: "member"}}, {user: {login: "me"}}, {user: {login: "MARKER-OUTSIDE-stranger"}}]}},
      {id: "tp3", url: "https://x/tp3", createdAt: "2026-01-06", isMinimized: false, body: "popular",
       authorAssociation: "MEMBER", author: {__typename: "User", login: "member"}, databaseId: 93, path: "p", line: 1,
       reactions: {totalCount: 41, nodes: [{user: {login: "me"}}]}}]}}]' \
  "$here/fixtures/threads.json" > "$tmp/fx-agree/threads.json"
jq '(.[0].data.repository.pullRequest.reviews.nodes[] | select(.id == "r1")) += {createdAt: "2026-01-01", submittedAt: "2026-01-09"}' \
  "$here/fixtures/reviews.json" > "$tmp/fx-agree/reviews.json"
got=$(FXDIR="$tmp/fx-agree" run .)
check "a thumbs-up comes through for the token's account and the thread's people, never a stranger's" \
  "$(status "$got") $(out "$got" | jq -c '[.threads[] | select(.id == "tp") | .comments[] | [.id, .thumbs_up]]')" \
  '0 [["tp1",[]],["tp2",["me","member"]],["tp3",["me"]]]'
check "a review's at is when it was submitted, not when it was started" \
  "$(out "$got" | jq -c '[.reviews[] | select(.id == "r1") | .at]')" '["2026-01-09"]'
check "thumbs_up_complete says whether every thumbs-up was read" \
  "$(out "$got" | jq -c '[.threads[] | select(.id == "tp") | .comments[] | .thumbs_up_complete]')" '[true,true,false]'
check "no stranger's login reaches the output" "$(grep -c MARKER-OUTSIDE <<<"$got" || true)" 0
check "each kept item says when it was written, and the output names the token's account" \
  "$(out "$got" | jq -c '[.viewer, ([.reviews[], .comments[], (.threads[].comments[] | select(.cleared | not))] | all(.at != null))]')" '["me",true]'

# resolve-thread. Its threads, beside the shared fixtures: each node is
# [id, login, association, body, thumbs-up logins], a Bot when the login is
# copilot's, "me" the token's account.
mkdir "$tmp/fx-resolve"; cp "$here"/fixtures/*.json "$tmp/fx-resolve/"
jq '.[0].data.repository.pullRequest.reviewThreads.nodes += ($threads | map(. as [$id, $nodes]
    | {id: $id, isResolved: false, isOutdated: false, comments: {pageInfo: {hasNextPage: false},
        nodes: [$nodes | to_entries[] | .key as $k | .value as [$cid, $login, $assoc, $body, $up]
          | {id: $cid, url: "https://x/\($cid)", createdAt: "2026-02-0\($k + 1)", isMinimized: false, body: $body,
             authorAssociation: $assoc, databaseId: 100, path: "p", line: 1,
             reactions: {totalCount: ($up | length), nodes: [$up[] | {user: {login: .}}]},
             author: (if $login == "copilot-pull-request-reviewer" then {__typename: "Bot", login: $login, databaseId: 175728472}
                      else {__typename: "User", login: $login} end)}]}}))' \
  --argjson threads '[
    ["t14", [["t14a", "copilot-pull-request-reviewer", "NONE", "a finding", []],
             ["t14b", "me", "MEMBER", "Not doing this — reasoning", []]]],
    ["t15", [["t15a", "member", "MEMBER", "please rename it", []],
             ["t15b", "me", "MEMBER", "Fixed — renamed", []]]],
    ["t16", [["t16a", "member", "MEMBER", "please rename it", []],
             ["t16b", "me", "MEMBER", "Not doing this — reasoning", []],
             ["t16c", "member", "MEMBER", "agreed, resolve it", []]]],
    ["t17", [["t17a", "member", "MEMBER", "please rename it", []],
             ["t17b", "me", "MEMBER", "Not doing this — reasoning", ["member"]]]],
    ["t18", [["t18a", "member", "MEMBER", "please rename it", []],
             ["t18b", "me", "MEMBER", "Not doing this — reasoning", []]]],
    ["t19", [["t19a", "copilot-pull-request-reviewer", "NONE", "a finding", []],
             ["t19b", "me", "MEMBER", "Fixed — done", []],
             ["t19c", "copilot-pull-request-reviewer", "NONE", "still wrong", []]]],
    ["t20", [["t20a", "copilot-pull-request-reviewer", "NONE", "a finding", []],
             ["t20b", "me", "MEMBER", "Not doing this — reasoning", []],
             ["t20c", "me", "MEMBER", "no, do it", []]]]]' \
  "$here/fixtures/threads.json" > "$tmp/fx-resolve/threads.json"
cp "$tmp/fx-resolve/reviews.json" "$tmp/fx-resolve/reviews-base.json"
# approve AT: the member approves the PR, submitted at AT.
approve() {
  jq --arg at "$1" '.[0].data.repository.pullRequest.reviews.nodes += [{id: "ra", url: "https://x/ra",
      createdAt: "2026-01-01", submittedAt: $at, isMinimized: false, body: "", authorAssociation: "MEMBER",
      author: {__typename: "User", login: "member"}, state: "APPROVED", commit: {oid: "abc"}}]' \
    "$tmp/fx-resolve/reviews-base.json" > "$tmp/fx-resolve/reviews.json"
}

# resolve "THREAD HOW [--agreed LOGIN]" CHECKS [HEAD_OID]: CHECKS is the head's
# check rollup, a bare state (no contexts), or contexts as
# "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests", req marking a check the
# base's ruleset requires, PENDING one still running, and missing one the
# ruleset requires that has no context on the head. Prints the output, a line
# saying whether the mutation ran, and the exit status.
resolve() {
  jq . "$here/fixtures/head.json" > "$tmp/head.json"
  if [[ $2 == *=* ]]; then
    jq -n --arg oid "${3:-abc}" --arg spec "$2" '
      [$spec | split(",")[] | select(test("=")) | capture("(?<kind>req|opt):(?<name>[^=]+)=(?<c>.+)")
        | {__typename: "CheckRun", name, isRequired: (.kind == "req"),
           status: (if .c == "PENDING" then "IN_PROGRESS" else "COMPLETED" end),
           conclusion: (if .c == "PENDING" then null else .c end)}] as $nodes
      | [$spec | split(",")[] | capture("^(?:req:(?<r>[^=]+)=|missing:(?<m>.+))") | .r // .m] as $named
      | ([$spec | split(",")[] | capture("^pattern:(?<p>.+)") | .p] | if length > 0 then . else ["~DEFAULT_BRANCH"] end) as $include
      | [$spec | split(",")[] | capture("^exclude:(?<p>.+)") | .p] as $exclude
      | ([$spec | split(",")[] | capture("^base:(?<b>.+)") | .b][0] // "main") as $basename
      | ($spec | split(",") | any(. == "workflows")) as $workflows
      | {data: {repository: {
          defaultBranchRef: {name: "main"},
          rulesets: {pageInfo: {hasNextPage: false}, nodes: [{enforcement: "ACTIVE", target: "BRANCH",
            conditions: {refName: {include: $include, exclude: $exclude}},
            rules: {nodes: ([{type: "REQUIRED_STATUS_CHECKS", parameters: {requiredStatusChecks: [$named[] | {context: .}]}}]
              + (if $workflows then [{type: "WORKFLOWS", parameters: {}}] else [] end))}}]},
          pullRequest: {baseRef: {name: $basename, branchProtectionRule: null}, commits: {nodes: [{commit: {oid: $oid, statusCheckRollup: {
          state: (if any($nodes[]; .conclusion == "FAILURE") then "FAILURE"
                  elif any($nodes[]; .conclusion == null) then "PENDING" else "SUCCESS" end),
          contexts: {pageInfo: {hasNextPage: false}, nodes: $nodes}}}}]}}}}}' > "$tmp/checks.json"
  else
    jq -n --arg oid "${3:-abc}" --arg state "$2" '{data: {repository: {pullRequest: {commits: {nodes: [{commit:
      {oid: $oid, statusCheckRollup: (if $state == "NONE" then null else {state: $state} end)}}]}}}}}' > "$tmp/checks.json"
  fi
  rm -f "$tmp/head-read" "$tmp/head-read.resolved"
  : > "$tmp/calls"
  local status=0
  PATH="$tmp/bin:$PATH" FX="$tmp/fx-resolve" FX_HEAD="$tmp/head.json" FX_STATE="$tmp/head-read" FX_CHECKS="$tmp/checks.json" \
    FX_CALLS="$tmp/calls" "$scripts/resolve-thread" o/r 1 $1 > "$tmp/out.json" 2>/dev/null || status=$?
  cat "$tmp/out.json"
  if [ -e "$tmp/head-read.resolved" ]; then echo resolved; else echo untouched; fi
  echo "$status"
}
ran() { tail -n 2 <<<"$1" | head -n 1; }
resolves() { got=$(resolve "$2" "$3"); check "$1" "$(status "$got") $(ran "$got")" "0 resolved"; }
# holds NAME "THREAD HOW" CHECKS WHY [HEAD_OID]: refused, for the reason WHY names.
holds() {
  got=$(resolve "$2" "$3" "${5:-abc}")
  check "$1" "$(status "$got") $(ran "$got") $(sed '$d' <<<"$got" | sed '$d' | jq -r --arg why "$4" '.refused | test($why)')" "3 untouched true"
}
approve 2026-01-01
resolves "a declined thread whose last reply is the token's resolves" "t14 declined" NONE
resolves "a fixed thread resolves once the head's checks pass" "t14 fixed" SUCCESS
holds "a fixed thread holds while the head's checks run" "t14 fixed" PENDING "haven't finished"
holds "a fixed thread holds before any check reports" "t14 fixed" NONE "no checks"
holds "a fixed thread holds when the head's checks failed" "t14 fixed" FAILURE "ended FAILURE"
holds "a fixed thread holds when the head moved after the read" "t14 fixed" SUCCESS "head moved" def
resolves "a fixed thread resolves when the required check passed, though an optional runner's failed" \
  "t14 fixed" "req:gate=SUCCESS,opt:setup-check/linux=FAILURE"
resolves "a required check skipped counts as passed, as GitHub counts it" "t14 fixed" "req:gate=SKIPPED,opt:linux=SUCCESS"
holds "a fixed thread holds when the required check failed, though every other passed" \
  "t14 fixed" "req:gate=FAILURE,opt:linux=SUCCESS" "required check failed"
holds "a fixed thread holds while the required check runs, though every other passed" \
  "t14 fixed" "req:gate=PENDING,opt:linux=SUCCESS" "required check hasn.t finished"
holds "a check the base's ruleset requires that hasn't reported holds, though the required one that did passed and an optional one failed" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests" "requires hasn.t reported"
holds "a ruleset whose glob reaches the base names its required checks" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests,pattern:refs/heads/ma*" "requires hasn.t reported"
resolves "a ruleset whose pattern doesn't reach the base names nothing" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests,pattern:refs/heads/release/*"
holds "a ruleset pattern this script can't convert (fnmatch's [...]) is read as reaching, so it fails closed" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests,pattern:refs/heads/rel[0-9]" "requires hasn.t reported"
holds "a ruleset naming a base with a literal dot reaches it, the dot escaped and not a wildcard" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests,base:release/v1.0,pattern:refs/heads/release/v1.0" "requires hasn.t reported"
resolves "a dotted pattern matches only its own name, so release/v1x0 is not release/v1.0" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests,base:release/v1x0,pattern:refs/heads/release/v1.0"
holds "an unconvertible pattern in a ruleset's exclusions is read as not excluding, so the ruleset's checks stay required" \
  "t14 fixed" "req:gate=SUCCESS,opt:linux=FAILURE,missing:tests,pattern:~ALL,exclude:refs/heads/rel[0-9]" "requires hasn.t reported"
holds "a Workflows rule reaching the base holds a fix as unjudged, since it names runs rather than contexts" \
  "t14 fixed" "req:gate=SUCCESS,workflows" "requires workflows"
holds "where the base requires no check, every check counts" "t14 fixed" "opt:gate=SUCCESS,opt:linux=FAILURE" "ended FAILURE"
resolves "where the base requires no check, all green resolves" "t14 fixed" "opt:gate=SUCCESS,opt:publish=SKIPPED"
