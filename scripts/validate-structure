#!/usr/bin/env bash
set -euo pipefail

# Validate the symlink-inversion structure:
# - Every entry in skills/ is a symlink pointing into a plugin's skills/ dir
# - Every skill in a plugin's skills/ has a corresponding symlink in skills/
# - No plugin.json declares a skills field (skills are auto-discovered)
# - Every plugin agent has the frontmatter Claude Code needs to load it

errors=0
root="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: python3 is required but not found"
  exit 1
fi

# 1. Every entry in skills/ must be a symlink pointing into a plugin skills dir
while IFS= read -r entry; do
  name="$(basename "$entry")"
  link="$root/skills/$name"

  if [ ! -L "$link" ]; then
    echo "ERROR: skills/$name is not a symlink"
    errors=$((errors + 1))
  elif [ ! -e "$link" ]; then
    echo "ERROR: skills/$name is a broken symlink -> $(readlink "$link")"
    errors=$((errors + 1))
  else
    target="$(readlink "$link")"
    if [[ ! "$target" =~ ^\.\.\/plugins\/[^/]+\/skills\/[^/]+$ ]]; then
      echo "ERROR: skills/$name -> $target (must match ../plugins/{plugin}/skills/{name})"
      errors=$((errors + 1))
    elif [[ "$(basename "$target")" != "$name" ]]; then
      echo "ERROR: skills/$name -> $target (symlink name must match target directory name)"
      errors=$((errors + 1))
    fi
  fi
done < <(find "$root/skills" -mindepth 1 -maxdepth 1)

# 2. Every plugin must have a manifest and skills/ dir; every skill has a symlink
for plugin_dir in "$root"/plugins/*/; do
  [ -d "$plugin_dir" ] || continue
  plugin="$(basename "$plugin_dir")"

  if [ ! -f "$plugin_dir/.claude-plugin/plugin.json" ]; then
    echo "ERROR: plugins/$plugin is missing .claude-plugin/plugin.json"
    errors=$((errors + 1))
  fi

  skills_dir="$plugin_dir/skills"
  if [ ! -d "$skills_dir" ]; then
    echo "ERROR: plugins/$plugin is missing skills/ directory"
    errors=$((errors + 1))
    continue
  fi

  while IFS= read -r skill_dir; do
    name="$(basename "$skill_dir")"

    if [ -L "$skill_dir" ]; then
      echo "ERROR: plugins/$plugin/skills/$name is a symlink (must be a real directory for git-subdir)"
      errors=$((errors + 1))
      continue
    elif [ ! -d "$skill_dir" ]; then
      echo "ERROR: plugins/$plugin/skills/$name is not a directory"
      errors=$((errors + 1))
      continue
    fi
    link="$root/skills/$name"

    if [ ! -L "$link" ]; then
      echo "ERROR: plugins/$plugin/skills/$name has no symlink in skills/"
      errors=$((errors + 1))
    else
      target="$(readlink "$link")"
      expected="../plugins/$plugin/skills/$name"
      if [ "$target" != "$expected" ]; then
        echo "ERROR: skills/$name -> $target (expected $expected)"
        errors=$((errors + 1))
      fi
    fi
  done < <(find "$skills_dir" -mindepth 1 -maxdepth 1)
done

# 3. No plugin.json may declare a skills field. Skills are auto-discovered from
# the plugin's skills/ directory; the field is redundant, and its path format
# has broken installs before (issue #23).
for plugin_dir in "$root"/plugins/*/; do
  [ -d "$plugin_dir" ] || continue
  plugin="$(basename "$plugin_dir")"
  manifest="$plugin_dir/.claude-plugin/plugin.json"
  [ -f "$manifest" ] || continue

  status=0
  python3 - "$manifest" <<'PYEOF' || status=$?
import json, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

if not isinstance(data, dict):
    sys.exit(2)
sys.exit(3 if "skills" in data else 0)
PYEOF

  if [ "$status" -eq 3 ]; then
    echo "ERROR: plugins/$plugin plugin.json declares a 'skills' field — remove it." \
         "Skills are auto-discovered from the plugin's skills/ directory; the field is" \
         "redundant and its path format has broken installs before (issue #23)"
    errors=$((errors + 1))
  elif [ "$status" -ne 0 ]; then
    echo "ERROR: plugins/$plugin plugin.json is not a JSON object"
    errors=$((errors + 1))
  fi
done

# 4. Every plugin agent loads: frontmatter with a name matching its file and a
# description, and an autoCompactWindow, if set, that Claude Code accepts. A bad
# one isn't an error there: the agent loads without it, warned only in a debug log.
for agent in "$root"/plugins/*/agents/*.md; do
  [ -f "$agent" ] || continue
  rel="${agent#"$root"/}"
  while IFS= read -r problem; do
    echo "ERROR: $rel $problem"
    errors=$((errors + 1))
  done < <(python3 - "$agent" <<'PYEOF'
import os, re, sys

path = sys.argv[1]
lines = open(path).read().split("\n")
if not lines or lines[0] != "---" or "---" not in lines[1:]:
    print("has no frontmatter")
    sys.exit()
fields = {}
for line in lines[1:lines.index("---", 1)]:
    m = re.match(r"([A-Za-z]+):\s*(.*)$", line)
    if m:
        fields[m.group(1)] = m.group(2).strip()
stem = os.path.basename(path)[:-3]
if fields.get("name") != stem:
    print(f"name must be '{stem}', matching its file")
if not fields.get("description"):
    print("has no description")
window = fields.get("autoCompactWindow")
if window is not None and not (window.isdigit() and 100000 <= int(window) <= 1000000):
    print(f"autoCompactWindow '{window}' must be an integer from 100000 to 1000000")
PYEOF
)
done

if [ "$errors" -gt 0 ]; then
  echo ""
  echo "FAILED: $errors error(s) found"
  exit 1
fi

echo "OK: structure is valid"
